<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monthly Revenue Report</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      background: #050010 url('/bg.png') no-repeat center center fixed;
      background-size: cover;
      color: #fff;
    }
    .card {
      background: rgba(255, 255, 255, 0.03) !important;
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-radius: 20px !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
      transition: all 0.3s ease;
    }
    .card:hover {
      background: rgba(255, 255, 255, 0.05) !important;
      border-color: rgba(255, 255, 255, 0.2) !important;
      box-shadow: 0 10px 40px rgba(79, 70, 229, 0.3) !important;
    }
    .nav-tabs {
      border-bottom: 1px solid rgba(255,255,255,0.1);
      margin-bottom: 30px;
    }
    .nav-link {
      color: #aaa;
    }
    .nav-link:hover {
      color: #fff;
      border-color: transparent transparent rgba(255,255,255,0.1) transparent;
    }
    .nav-link.active {
      background: transparent !important;
      color: #4f46e5 !important;
      border-color: transparent transparent #4f46e5 transparent !important;
      border-bottom-width: 2px !important;
    }
    .card-header {
      background: transparent;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
  </style>
</head>
<body>

<ul class="nav nav-tabs px-4 pt-3">
  <li class="nav-item"><a class="nav-link fw-bold" href="/dashboard">Dashboard</a></li>
  <li class="nav-item"><a class="nav-link fw-bold" href="/products">Products</a></li>
  <li class="nav-item"><a class="nav-link active fw-bold" href="/revenue-dashboard">Revenue</a></li>
  <li class="nav-item"><a class="nav-link fw-bold" href="/sales">Sales Data</a></li>
  <li class="nav-item"><a class="nav-link fw-bold" href="/customers">Customers</a></li>
</ul>

<div class="container mt-4">
  <div class="card">
    <div class="card-header py-3">
      <h4 class="mb-0 fw-bold">Revenue Growth Chart</h4>
    </div>
    <div class="card-body">
      <canvas id="revenueChart" style="max-height: 400px;"></canvas>
    </div>
  </div>
</div>

<script>
  const revenueData = <%- JSON.stringify(revenueData) %>;
  
  const ctx = document.getElementById('revenueChart').getContext('2d');
  new Chart(ctx, {
    type: 'line', // User asked for tension and fill, which applies to line charts (or kept as bar, but line fits the styling requested better. I will switch to line to support tension and fill)
    data: {
      labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
      datasets: [{
        label: 'Monthly Revenue (₹)',
        data: revenueData,
        borderColor: "#4f46e5",
        backgroundColor: "rgba(79,70,229,0.2)",
        tension: 0.4,
        fill: true,
        borderWidth: 2,
        pointBackgroundColor: "#4f46e5",
        pointBorderColor: "#fff",
        pointHoverBackgroundColor: "#fff",
        pointHoverBorderColor: "#4f46e5"
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          labels: { color: '#aaa' }
        }
      },
      scales: {
        x: {
          grid: { color: 'rgba(255,255,255,0.05)' },
          ticks: { color: '#aaa' }
        },
        y: { 
          beginAtZero: true, 
          grid: { color: 'rgba(255,255,255,0.05)' },
          ticks: { 
            color: '#aaa',
            callback: function(value) { return '₹' + value; } 
          } 
        }
      }
    }
  });
</script>

</body>
</html>
