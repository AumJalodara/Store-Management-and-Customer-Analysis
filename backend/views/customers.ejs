<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customers | SmartStore</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #0a0a0a, #111827, #1f2937) fixed;
      color: #fff;
      font-family: 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
    }
    .nav-tabs {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      margin-bottom: 40px;
    }
    .nav-link {
      color: rgba(255, 255, 255, 0.5);
      border: none !important;
      padding: 15px 25px;
      font-weight: 600;
    }
    .nav-link.active {
      background: transparent !important;
      color: #7c3aed !important;
      border-bottom: 2px solid #7c3aed !important;
    }
    .card {
      background: rgba(255, 255, 255, 0.03) !important;
      backdrop-filter: blur(15px);
      border-radius: 20px !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
    }
    .table {
      color: #ccc;
      --bs-table-bg: transparent;
    }
    .table-hover tbody tr:hover {
      background-color: rgba(255, 255, 255, 0.05);
      color: #fff;
    }
    .btn-primary {
      background: linear-gradient(135deg, #4f46e5, #7c3aed) !important;
      border: none !important;
      border-radius: 12px !important;
      padding: 8px 16px !important;
    }
  </style>
</head>
<body>

<ul class="nav nav-tabs px-4 pt-3">
  <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
  <li class="nav-item"><a class="nav-link" href="/products">Products</a></li>
  <li class="nav-item"><a class="nav-link" href="/revenue-dashboard">Revenue</a></li>
  <li class="nav-item"><a class="nav-link" href="/sales">Sales Data</a></li>
  <li class="nav-item"><a class="nav-link active" href="/customers">Customers</a></li>
</ul>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Customer Directory</h2>
    <a href="/customers/add" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Customer</a>
  </div>

  <div class="card overflow-hidden">
    <div class="card-body p-0">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-white bg-opacity-5">
          <tr>
            <th class="ps-4">ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th class="pe-4 text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% customers.forEach(function(c) { %>
            <tr>
              <td class="ps-4 text-white-50"><%= c.id %></td>
              <td class="fw-bold text-white"><%= c.name %></td>
              <td><%= c.email %></td>
              <td><%= c.phone %></td>
              <td class="pe-4 text-end">
                <button class="btn btn-sm text-white-50 hover-white"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-sm text-white-50 hover-white"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

</body>
</html>
